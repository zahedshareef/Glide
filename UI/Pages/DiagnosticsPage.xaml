<Page x:Class="SmoothScroller.UI.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Diagnostics">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="Diagnostics" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Content="Refresh"   Margin="0,0,8,0" Click="Refresh_Click"/>
                <ui:Button Content="Clear Log" Click="Clear_Click"/>
            </StackPanel>

            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" MinHeight="300" MinWidth="500">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText"
                               FontFamily="Consolas, Courier New"
                               FontSize="12"
                               Padding="12"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
