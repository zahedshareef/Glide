<Page x:Class="SmoothScroller.UI.Pages.ScrollPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Scrolling">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Settings -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Text="Scrolling" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>

                <!-- Step Size -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Step Size" FontWeight="Medium"/>
                            <TextBlock Text="Pixels per wheel notch" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StepSizeLabel" Text="120 px" FontSize="12" FontWeight="SemiBold" Width="50" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                        <Slider x:Name="StepSizeSlider" Minimum="20" Maximum="500" TickFrequency="10" Width="150" VerticalAlignment="Center"
                                ValueChanged="StepSize_Changed"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Animation Time -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Animation Time" FontWeight="Medium"/>
                            <TextBlock Text="Duration of scroll animation" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AnimTimeLabel" Text="360 ms" FontSize="12" FontWeight="SemiBold" Width="50" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                        <Slider x:Name="AnimTimeSlider" Minimum="50" Maximum="2000" TickFrequency="10" Width="150" VerticalAlignment="Center"
                                ValueChanged="AnimTime_Changed"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Acceleration Delta -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Acceleration Delta" FontWeight="Medium"/>
                            <TextBlock Text="Max inter-event time for acceleration to apply" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AccelDeltaLabel" Text="70 ms" FontSize="12" FontWeight="SemiBold" Width="50" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                        <Slider x:Name="AccelDeltaSlider" Minimum="20" Maximum="500" TickFrequency="10" Width="150" VerticalAlignment="Center"
                                ValueChanged="AccelDelta_Changed"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Acceleration Max -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Acceleration Max" FontWeight="Medium"/>
                            <TextBlock Text="Maximum acceleration multiplier" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AccelMaxLabel" Text="7.0x" FontSize="12" FontWeight="SemiBold" Width="50" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                        <Slider x:Name="AccelMaxSlider" Minimum="1" Maximum="20" TickFrequency="1" Width="150" VerticalAlignment="Center"
                                ValueChanged="AccelMax_Changed"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Tail to Head -->
                <ui:CardControl Margin="0,0,0,24">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Tail-to-Head Ratio" FontWeight="Medium"/>
                            <TextBlock Text="Easing end-to-start speed ratio" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TailHeadLabel" Text="3.0x" FontSize="12" FontWeight="SemiBold" Width="50" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
                        <Slider x:Name="TailHeadSlider" Minimum="1" Maximum="10" TickFrequency="1" Width="150" VerticalAlignment="Center"
                                ValueChanged="TailHead_Changed"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Toggles -->
                <TextBlock Text="Behavior" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Animation Easing" FontWeight="Medium"/>
                            <TextBlock Text="Smoothly ease in and out of the scroll" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="EasingToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Shift Key → Horizontal Scroll" FontWeight="Medium"/>
                            <TextBlock Text="Convert vertical to horizontal scroll holding Shift" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ShiftHorizToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Horizontal Smoothness" FontWeight="Medium"/>
                            <TextBlock Text="Apply smooth scrolling to horizontal scrolls" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="HorizSmoothnessToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Reverse Wheel Direction" FontWeight="Medium"/>
                            <TextBlock Text="Invert vertical and horizontal wheel directions" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ReverseToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Click to Stop Animation" FontWeight="Medium"/>
                            <TextBlock Text="Stop scrolling immediately when a mouse button is clicked" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ClickStopToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </ui:CardControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Right: Live Test Area -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel Margin="16">
                <TextBlock Text="Live Preview" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,12"/>
                <TextBlock Text="Scroll here to test your settings:"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                           FontSize="12" TextWrapping="Wrap"/>
                <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock TextWrapping="Wrap" Width="200" FontSize="12"
                            Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore."/>
                        <TextBlock TextWrapping="Wrap" Width="200" FontSize="12" Margin="0,200,0,200"
                            Text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur."/>
                        <TextBlock TextWrapping="Wrap" Width="200" FontSize="12"
                            Text="Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium."/>
                        <TextBlock TextWrapping="Wrap" Width="200" FontSize="12" Margin="0,200,0,200"
                            Text="Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit consequuntur."/>
                        <TextBlock TextWrapping="Wrap" Width="200" FontSize="12"
                            Text="At vero eos et accusamus et iusto odio dignissimos ducimus blanditiis praesentium."/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

    </Grid>
</Page>
