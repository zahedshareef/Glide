<Page x:Class="SmoothScroller.UI.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Advanced">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">

            <TextBlock Text="Advanced" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <!-- Input section -->
            <TextBlock Text="Input" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Disable for Touchpad" FontWeight="Medium"/>
                        <TextBlock Text="Skip smooth scrolling when a precision touchpad is detected"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="TouchpadToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Frame-Rate Adaptive Animation" FontWeight="Medium"/>
                        <TextBlock Text="Tie animation ticks to monitor refresh rate"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="FrameRateToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,24">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Scale Step Size with DPI" FontWeight="Medium"/>
                        <TextBlock Text="Automatically scale scroll distance on high-DPI displays"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="DpiToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
            </ui:CardControl>

            <!-- Speed threshold -->
            <TextBlock Text="Behavior" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <ui:CardExpander Margin="0,0,0,16" Header="Speed Threshold for Smooth Scroll">
                <StackPanel Margin="8,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Fast flicks skip animation above threshold  "
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="SpeedThresholdLabel" Text="0 (always smooth)" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="Set to 0 to always smooth. Higher values let fast flicks scroll natively."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Slider x:Name="SpeedThresholdSlider" Minimum="0" Maximum="50" ValueChanged="SpeedThreshold_Changed"/>
                </StackPanel>
            </ui:CardExpander>

            <!-- Diagnostics -->
            <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Diagnostics Mode" FontWeight="Medium"/>
                        <TextBlock Text="Log events to %AppData%\SmoothScroller\diagnostics.log"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="DiagToggle" Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
            </ui:CardControl>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="Check for Updates" Margin="0,0,8,0" Click="CheckUpdate_Click"/>
                <ui:Button Content="Open Log Folder"   Click="OpenLogFolder_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
