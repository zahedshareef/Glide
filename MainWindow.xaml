<ui:FluentWindow
    x:Class="SmoothScroller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SmoothScroller Settings"
    MinWidth="800" MinHeight="560"
    Width="860" Height="620"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="SmoothScroller"
            ShowMinimize="True"
            ShowMaximize="False"
            ShowClose="True" />

        <!-- Navigation shell -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView
                Grid.Column="0" Grid.ColumnSpan="2"
                x:Name="NavView"
                PaneDisplayMode="Left"
                IsPaneOpen="True"
                OpenPaneLength="180"
                Loaded="NavView_Loaded">

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="General"    Icon="Home24"      x:Name="NavGeneral"  />
                    <ui:NavigationViewItem Content="Scrolling"  Icon="ArrowSort24" x:Name="NavScroll"   />
                    <ui:NavigationViewItem Content="Per-App"    Icon="Apps24"      x:Name="NavPerApp"   />
                    <ui:NavigationViewItem Content="Advanced"   Icon="Settings24"  x:Name="NavAdvanced" />
                    <ui:NavigationViewItem Content="Diagnostics" Icon="Bug24"      x:Name="NavDiag"     />
                </ui:NavigationView.MenuItems>

            </ui:NavigationView>

            <Frame Grid.Column="1" x:Name="ContentFrame" Margin="180,0,0,0" />
        </Grid>
    </Grid>
</ui:FluentWindow>
